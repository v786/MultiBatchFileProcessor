# Every setting in pipeline/config.py can be overridden here or in docker-compose.yml.
VENDOR_SLOTS=20
VENDOR_TIMEOUT_S=30
VENDOR_PER_USER_SLOTS=10
# Mock vendor: 1.0 = real 10-20 s replies; 0.01 = 0.1-0.2 s for quick demos
MOCK_LATENCY_SCALE=1.0
MOCK_ERROR_RATE=0.05
MOCK_TIMEOUT_RATE=0.02
MOCK_REJECT_RATE=0.01
